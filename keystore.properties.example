# Copia este fichero como keystore.properties (no se versiona) para firmar el release.
# En CI, define las mismas claves como variables de entorno (tienen prioridad).
#
# Crear el keystore:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias release

# Ruta relativa a la raíz del proyecto (o absoluta).
RELEASE_STORE_FILE=release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=release
RELEASE_KEY_PASSWORD=
