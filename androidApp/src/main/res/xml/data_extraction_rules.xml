<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y traspaso entre dispositivos en Android 12+.
     La sesión cifrada no se copia: su clave vive en el Keystore del dispositivo y no viaja en la
     copia, así que al restaurarla en otro dispositivo no se podría descifrar. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="encrypted_token_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="encrypted_token_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
